    <script>
        const scenarios = {
            conservative: { name: 'Relationship Build', partnerRate: 400, associateRate: 175, util: [30, 40, 48], revenue: [443520, 591360, 709632] },
            moderate:     { name: 'Balanced Advisory',  partnerRate: 450, associateRate: 175, util: [38, 48, 55], revenue: [632736, 799488, 915840] },
            optimistic:   { name: 'High Demand',        partnerRate: 550, associateRate: 175, util: [45, 55, 62], revenue: [913680, 1116720, 1258992] }
        };

        let currentScenario = 'moderate';

        function init() {
            updateScenario();
            populateMonthlyTracker();
            updateLastUpdated();
        }

        function updateScenario() {
            const scenario = document.getElementById('scenario').value;
            currentScenario = scenario;
            const data = scenarios[scenario];
            document.getElementById('partner-rate').value = data.partnerRate;
            document.getElementById('associate-rate').value = data.associateRate;
            document.getElementById('util-y1').value = data.util[0];
            document.getElementById('util-y2').value = data.util[1];
            document.getElementById('util-y3').value = data.util[2];
            updateCalculations();
        }

        function updateCalculations() {
            const partnerRate = parseFloat(document.getElementById('partner-rate').value);
            const associateRate = parseFloat(document.getElementById('associate-rate').value);
            const partnerCount = parseFloat(document.getElementById('partner-count').value);
            const associateCount = parseFloat(document.getElementById('associate-count').value);
            const util1 = parseFloat(document.getElementById('util-y1').value) / 100;
            const util2 = parseFloat(document.getElementById('util-y2').value) / 100;
            const util3 = parseFloat(document.getElementById('util-y3').value) / 100;
            const profitMargin = parseFloat(document.getElementById('profit-margin').value) / 100;
            const startupCapital = parseFloat(document.getElementById('startup-capital').value);
            const hoursPerYear = 1840;

            const y1Revenue = Math.round((partnerCount * hoursPerYear * util1 * partnerRate) + (associateCount * hoursPerYear * util1 * associateRate));
            const y2Revenue = Math.round((partnerCount * hoursPerYear * util2 * partnerRate) + (associateCount * hoursPerYear * util2 * associateRate));
            const y3Revenue = Math.round((partnerCount * hoursPerYear * util3 * partnerRate) + (associateCount * hoursPerYear * util3 * associateRate));
            const total3Year = y1Revenue + y2Revenue + y3Revenue;
            const y1Profit = Math.round(y1Revenue * profitMargin);
            const y3Profit = Math.round(y3Revenue * profitMargin);

            document.getElementById('year1-revenue').textContent = y1Revenue.toLocaleString();
            document.getElementById('year3-revenue').textContent = y3Revenue.toLocaleString();
            document.getElementById('total-3year').textContent = total3Year.toLocaleString();
            document.getElementById('year1-profit').textContent = y1Profit.toLocaleString();
            document.getElementById('year3-profit').textContent = y3Profit.toLocaleString();

            document.getElementById('util-y1-bar').style.width = (util1 * 100) + '%';
            document.getElementById('util-y1-bar').textContent = (util1 * 100) + '%';
            document.getElementById('util-y2-bar').style.width = (util2 * 100) + '%';
            document.getElementById('util-y2-bar').textContent = (util2 * 100) + '%';
            document.getElementById('util-y3-bar').style.width = (util3 * 100) + '%';
            document.getElementById('util-y3-bar').textContent = (util3 * 100) + '%';

            const monthlyBurn = Math.round(startupCapital / 12);
            const runway = Math.round(startupCapital / monthlyBurn);
            document.getElementById('burn-rate').textContent = monthlyBurn.toLocaleString();
            document.getElementById('runway').textContent = runway;

            const marketShare = ((y3Revenue / 74400000000) * 100).toFixed(4);
            document.getElementById('market-share').textContent = marketShare;

            const growthY1Y2 = (((y2Revenue - y1Revenue) / y1Revenue) * 100).toFixed(1);
            const growthY2Y3 = (((y3Revenue - y2Revenue) / y2Revenue) * 100).toFixed(1);
            const cagr = ((Math.pow(y3Revenue / y1Revenue, 1/2) - 1) * 100).toFixed(1);
            
            document.getElementById('growth-y1-y2').textContent = growthY1Y2;
            document.getElementById('growth-y2-y3').textContent = growthY2Y3;
            document.getElementById('cagr').textContent = cagr;

            const costs = {
                workingCapital: startupCapital * 0.556,
                office: startupCapital * 0.200,
                tech: startupCapital * 0.080,
                insurance: startupCapital * 0.067,
                marketing: startupCapital * 0.036,
                professional: startupCapital * 0.053
            };

            document.getElementById('cost-working-capital').textContent = Math.round(costs.workingCapital).toLocaleString();
            document.getElementById('cost-office').textContent = Math.round(costs.office).toLocaleString();
            document.getElementById('cost-tech').textContent = Math.round(costs.tech).toLocaleString();
            document.getElementById('cost-insurance').textContent = Math.round(costs.insurance).toLocaleString();
            document.getElementById('cost-marketing').textContent = Math.round(costs.marketing).toLocaleString();
            document.getElementById('cost-professional').textContent = Math.round(costs.professional).toLocaleString();
            document.getElementById('cost-total').textContent = startupCapital.toLocaleString();

            updateLastUpdated();
        }

        function populateMonthlyTracker() {
            const milestones = [
                { month: 1, milestone: 'Formation & Infrastructure Setup', revenue: 0 },
                { month: 2, milestone: 'Personnel Recruitment Initiated', revenue: 0 },
                { month: 3, milestone: 'Facility Secured & Operational', revenue: 0 },
                { month: 6, milestone: 'First Advisory Retainer Signed ($20K+/mo)', revenue: 60000 },
                { month: 9, milestone: '3 Active Retainer Clients + First Speaking Engagement', revenue: 180000 },
                { month: 12, milestone: 'Year 1 Complete — Retainer Portfolio Established', revenue: 360000 },
                { month: 18, milestone: '5–6 Retainers + First Project Advisory Fee', revenue: 850000 },
                { month: 24, milestone: 'Year 2 Complete — Senior Associate Hired', revenue: 1280000 },
                { month: 30, milestone: 'First Equity Advisory Position Established', revenue: 1600000 },
                { month: 36, milestone: 'Year 3 Complete — 8–10 Retainer Clients', revenue: 1950000 }
            ];

            const tbody = document.getElementById('monthly-tracker');
            tbody.innerHTML = '';

            milestones.forEach(m => {
                const tr = document.createElement('tr');
                const status = m.month <= 3 ? 'status-pending' : m.month <= 6 ? 'status-at-risk' : 'status-on-track';
                const statusText = m.month <= 3 ? 'Pending' : m.month <= 6 ? 'In Progress' : 'Planned';
                
                tr.innerHTML = `
                    <td>Month ${m.month}</td>
                    <td>${m.milestone}</td>
                    <td><span class="status-badge ${status}">${statusText}</span></td>
                    <td>$${m.revenue.toLocaleString()}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updateLastUpdated() {
            document.getElementById('last-updated').textContent = new Date().toLocaleString();
        }

        function updateFundMetrics() {
            const fundSize = parseFloat(document.getElementById('fund-size').value);
            const mgmtFee = fundSize * 1000000 * 0.02;
            const gpCommit = fundSize * 1000000 * 0.10;
            const formationCost = 125000;

            document.getElementById('mgmt-fee').textContent = mgmtFee.toLocaleString();
            document.getElementById('gp-commit').textContent = gpCommit.toLocaleString();
            document.getElementById('formation-cost').textContent = formationCost.toLocaleString();

            // Update combined revenue
            document.getElementById('fund-rev-y3').textContent = mgmtFee.toLocaleString();
            document.getElementById('fund-rev-y4').textContent = mgmtFee.toLocaleString();
            document.getElementById('fund-rev-y5').textContent = mgmtFee.toLocaleString();

            const combinedY3 = 1794000 + mgmtFee;
            const combinedY4 = 1950000 + mgmtFee;
            const combinedY5 = 2150000 + mgmtFee;

            document.getElementById('combined-y3').textContent = combinedY3.toLocaleString();
            document.getElementById('combined-y4').textContent = combinedY4.toLocaleString();
            document.getElementById('combined-y5').textContent = combinedY5.toLocaleString();
        }

        function downloadData() {
            const data = {
                timestamp: new Date().toISOString(),
                classification: 'CONFIDENTIAL',
                scenario: currentScenario,
                parameters: {
                    partnerRate: document.getElementById('partner-rate').value,
                    associateRate: document.getElementById('associate-rate').value,
                    partnerCount: document.getElementById('partner-count').value,
                    associateCount: document.getElementById('associate-count').value,
                    utilizationY1: document.getElementById('util-y1').value,
                    utilizationY2: document.getElementById('util-y2').value,
                    utilizationY3: document.getElementById('util-y3').value,
                    startupCapital: document.getElementById('startup-capital').value,
                    profitMargin: document.getElementById('profit-margin').value
                },
                peStrategy: {
                    fundSize: document.getElementById('fund-size').value + 'M',
                    managementFee: document.getElementById('mgmt-fee').textContent,
                    gpCommitment: document.getElementById('gp-commit').textContent,
                    formationCost: document.getElementById('formation-cost').textContent,
                    combinedRevenueY3: document.getElementById('combined-y3').textContent
                },
                intelligence: {
                    year1Revenue: document.getElementById('year1-revenue').textContent,
                    year3Revenue: document.getElementById('year3-revenue').textContent,
                    totalRevenue: document.getElementById('total-3year').textContent,
                    year1Profit: document.getElementById('year1-profit').textContent,
                    year3Profit: document.getElementById('year3-profit').textContent,
                    marketShare: document.getElementById('market-share').textContent,
                    cagr: document.getElementById('cagr').textContent
                }
            };

            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `blacksmith-advisory-${new Date().toISOString().split('T')[0]}.json`;
            a.click();
        }

        init();
        updateFundMetrics();
    </script>
</body>
</html>
